@page "/session/{SessionId}"
@inject SessionStore _store
@inject Client _client

@using System

<PageTitle>@(_store.Session?.Title ?? "Session")</PageTitle>

@if (_store.Session is null) {
    <div class="spinner-border" style="position: absolute; left: 50%; top: 50%; margin-top:-3rem; margin-left: -3rem; width: 6rem; height: 6rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else {
    <ToastComponent />
    <JoinFormComponent />

    @if (Modal is EditModal.EditingTitle(var titleStatus)) {
        <div class="overlay">
            <div class="modal modal-md d-block"> <div class="modal-dialog"> <div class="modal-content"> <div class="modal-body">
                <form class="d-flex gap-2 w-100" @onsubmit=OnSaveTitleClicked>
                    <input type="text" class="form-control" placeholder="Enter a title for the session" required pattern="(.|\s)*\S(.|\s)*" @bind-value=Title>
                    <button class="btn border-0 btn-outline-success" type="submit" disabled="@(titleStatus is FormStatus.Submitting)"><ion-icon name="checkmark-sharp"></ion-icon></button>
                    <button class="btn border-0 btn-outline-secondary" disabled="@(titleStatus is FormStatus.Submitting)" @onclick=OnCloseModalClicked><ion-icon name="close-sharp"></ion-icon></button>
                </form>

                @if (titleStatus is FormStatus.Failed(var errorMessage)) {
                    <div class="alert alert-danger mb-0 mt-3">
                        <ion-icon name="alert-circle-sharp" style="margin-bottom: -8px; font-size: 20pt;"></ion-icon> @errorMessage
                    </div>
                }
            </div> </div> </div> </div>
        </div>
    }

    @if (Modal is EditModal.EditingName(var nameStatus)) {
        <div class="overlay">
            <div class="modal modal-md d-block"> <div class="modal-dialog"> <div class="modal-content"> <div class="modal-body">
                <form class="d-flex gap-2 w-100" @onsubmit=OnSaveNameClicked>
                    <input type="text" class="form-control" placeholder="Enter your name" required pattern="(.|\s)*\S(.|\s)*" @bind-value=Name>
                    <button class="btn border-0 btn-outline-success" type="submit" disabled="@(nameStatus is FormStatus.Submitting)"><ion-icon name="checkmark-sharp"></ion-icon></button>
                    <button class="btn border-0 btn-outline-secondary" disabled="@(nameStatus is FormStatus.Submitting)" @onclick=OnCloseModalClicked><ion-icon name="close-sharp"></ion-icon></button>
                </form>

                @if (nameStatus is FormStatus.Failed(var errorMessage)) {
                    <div class="alert alert-danger mb-0 mt-3">
                        <ion-icon name="alert-circle-sharp" style="margin-bottom: -8px; font-size: 20pt;"></ion-icon> @errorMessage
                    </div>
                }
            </div> </div> </div> </div>
        </div>
    }

    <ShareNotificationComponent />

    <div class="session" style="@(IsContentBlurred ? "filter: blur(1px)" : "")">
        <div class="card m-3 shadow-sm border-0" style="grid-area: header; width: 600px;">
            <div class="card-body p-2">
                <div class="d-flex gap-2 w-100 justify-content-between">
                    <button type="button" class="btn btn-outline-light border-0 text-dark hidden-icon fw-bold" disabled="@(Modal is not EditModal.None)" @onclick=OnEditTitleClicked>@_store.Session.Title <ion-icon name="settings-sharp"></ion-icon></button>
                    <button type="button" class="btn btn-outline-light border-0 text-dark hidden-icon" disabled="@(Modal is not EditModal.None)" @onclick=OnEditNameClicked><ion-icon name="person-sharp"></ion-icon> @_store.Self?.Name</button>
                </div>
            </div>
        </div>

        <AddComponent />
        <ToggleColorModeComponent />

        <div style="grid-area: main">
            <CenterTableComponent />
        </div>

        <div class="m-3 d-flex" style="position: absolute; bottom: 0; left: 0;">
            <ToastHistoryComponent />
        </div>

        <div style="grid-area: footer;">
            <PointSelectionComponent />
        </div>

        <div class="m-3 d-flex" style="position: absolute; bottom: 0; right: 0;">
            <CoffeeComponent />
            <HelpComponent />
        </div>
    </div>
}

@code {
    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    string Title { get; set; } = string.Empty;

    string Name { get; set; } = string.Empty;

    closed record EditModal {
        public sealed record None : EditModal;
        public sealed record EditingTitle(FormStatus Status) : EditModal;
        public sealed record EditingName(FormStatus Status) : EditModal;
    }

    EditModal Modal { get; set; } = new EditModal.None();

    bool IsContentBlurred =>
        _store.Self is null
        || Modal is not EditModal.None;

    protected override async Task OnInitializedAsync() {
        _store.Changed += (o, e) => StateHasChanged();
        await _client.LoadAsync(SessionId);
    }

    void OnEditTitleClicked() {
        Title = _store!.Session!.Title;
        Modal = new EditModal.EditingTitle(new FormStatus.Idle());
    }

    void OnEditNameClicked() {
        Name = _store.Self!.Name;
        Modal = new EditModal.EditingName(new FormStatus.Idle());
    }

    void OnCloseModalClicked() =>
        Modal = new EditModal.None();

    async Task OnSaveTitleClicked() {
        if (!string.IsNullOrWhiteSpace(Title)) {
            Modal = new EditModal.EditingTitle(new FormStatus.Submitting());

            try {
                await _client.UpdateTitleAsync(Title);
                Modal = new EditModal.None();
            }
            catch {
                Modal = new EditModal.EditingTitle(new FormStatus.Failed("An error occurred while updating the title. Please try again."));
            }
        }
    }

    async Task OnSaveNameClicked() {
        if (!string.IsNullOrWhiteSpace(Name)) {
            Modal = new EditModal.EditingName(new FormStatus.Submitting());

            try {
                await _client.UpdateNameAsync(Name);
                Modal = new EditModal.None();
            }
            catch {
                Modal = new EditModal.EditingName(new FormStatus.Failed("An error occurred while updating your name. Please try again."));
            }
        }
    }
}
