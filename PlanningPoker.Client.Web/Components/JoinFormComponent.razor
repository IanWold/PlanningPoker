@inject SessionStore _store
@inject Client _client

@if (_store.Self is null) {
    <div class="overlay">
        <div class="modal modal-md d-block"> <div class="modal-dialog"> <div class="modal-content"> <div class="modal-body">
            <form class="d-flex gap-2 w-100" @onsubmit=OnJoinClicked>
                <input type="text" class="form-control" placeholder="Enter your name to join the session" required pattern="(.|\s)*\S(.|\s)*" disabled="@(IsSubmitting)" @bind-value=Name>
                <button class="btn btn-primary" type="submit" disabled="@(IsSubmitting)">Join</button>
            </form>

            @if (Status is FormStatus.Failed(var errorMessage)) {
                <div class="alert alert-danger mb-0 mt-3">
                    <ion-icon name="alert-circle-sharp" style="margin-bottom: -8px; font-size: 20pt;"></ion-icon> @errorMessage
                </div>
            }
        </div> </div> </div> </div>
    </div>
}

@code {
    string Name { get; set; } = string.Empty;

    FormStatus Status { get; set; } = new FormStatus.Idle();

    bool IsSubmitting => Status is FormStatus.Submitting;

    protected override void OnInitialized() =>
        _store.Changed += (o, e) => StateHasChanged();

    async Task OnJoinClicked() {
        if (!string.IsNullOrWhiteSpace(Name)) {
            Status = new FormStatus.Submitting();

            try {
                await _client.JoinAsync(Name);
                Status = new FormStatus.Idle();
            }
            catch {
                Status = new FormStatus.Failed("An error occurred while joining the session. Please try again.");
            }
        }
    }
}
